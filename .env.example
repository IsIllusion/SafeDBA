# ============================================================
# SafeDBA environment configuration
# ============================================================

# Disposable test runners set SAFEDBA_SKIP_DOTENV=1 in their process environment
# to bypass this file. Normal application startup continues to load .env.
# Isolated profiles must set SAFEDBA_PROCESS_ROLE=agent or executor in the
# LAUNCH ENVIRONMENT, not here. Those profiles never load .env. Do not pass
# this combined development file to both processes. See docs/ISOLATED_EXECUTOR.md.
# Agent: observer/model credentials plus SAFEDBA_EXECUTOR_URL and API token.
# Worker: observer/terminator credentials plus private grant DB path; NO
# model key or maintenance password. OS service identities/ACLs are required.


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

SAFEDBA_DB_HOST=127.0.0.1
SAFEDBA_DB_PORT=15432
SAFEDBA_DB_NAME=benchmark
SAFEDBA_DB_USER=safedba_observer
SAFEDBA_DB_PASSWORD=local-observer-only
SAFEDBA_DB_CONNECT_TIMEOUT_SECONDS=10
SAFEDBA_DB_STATEMENT_TIMEOUT_MS=30000
SAFEDBA_DB_LOCK_TIMEOUT_MS=3000
SAFEDBA_DB_MAX_QUERY_LENGTH=50000
SAFEDBA_DB_MAX_EXPLAIN_TOTAL_COST=1000000
SAFEDBA_DB_MAX_OBSERVATION_ROWS=50
SAFEDBA_DB_MAX_OBSERVED_QUERY_CHARS=2000
SAFEDBA_DB_INCLUDE_OBSERVED_QUERY_TEXT=false

# Separate identity used only by the deterministic executor.
SAFEDBA_EXECUTOR_DB_HOST=127.0.0.1
SAFEDBA_EXECUTOR_DB_PORT=15432
SAFEDBA_EXECUTOR_DB_NAME=benchmark
SAFEDBA_EXECUTOR_DB_USER=safedba_executor
SAFEDBA_EXECUTOR_DB_PASSWORD=local-executor-only
SAFEDBA_EXECUTOR_DB_CONNECT_TIMEOUT_SECONDS=10

# Session termination identity: can inspect activity and signal backends,
# but does not own tables or receive schema-create privileges.
SAFEDBA_TERMINATOR_DB_HOST=127.0.0.1
SAFEDBA_TERMINATOR_DB_PORT=15432
SAFEDBA_TERMINATOR_DB_NAME=benchmark
SAFEDBA_TERMINATOR_DB_USER=safedba_terminator
SAFEDBA_TERMINATOR_DB_PASSWORD=local-terminator-only
SAFEDBA_TERMINATOR_DB_CONNECT_TIMEOUT_SECONDS=10


# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------

SAFEDBA_LLM_PROVIDER=deepseek

# DeepSeek example model
SAFEDBA_LLM_MODEL=deepseek-v4-flash

# Required for openai_compatible providers.
# DeepSeek uses its default API endpoint when left empty.
SAFEDBA_LLM_BASE_URL=

# Provider-neutral API key.
# Takes priority when configured.
SAFEDBA_LLM_API_KEY=

# DeepSeek-specific fallback.
# Use either this or SAFEDBA_LLM_API_KEY.
DEEPSEEK_API_KEY=


# ------------------------------------------------------------
# Reasoning
# ------------------------------------------------------------

SAFEDBA_LLM_REASONING_ENABLED=false
SAFEDBA_LLM_REASONING_EFFORT=high


# ------------------------------------------------------------
# LLM request policy
# ------------------------------------------------------------

SAFEDBA_LLM_TIMEOUT_SECONDS=120
SAFEDBA_LLM_MAX_RETRIES=1
SAFEDBA_LLM_MAX_COMPLETION_TOKENS=2500

# A fallback route is disabled unless SAFEDBA_LLM_FALLBACK_PROVIDER is set.
# Its API key is intentionally never inherited from the primary route.
SAFEDBA_LLM_FALLBACK_PROVIDER=
SAFEDBA_LLM_FALLBACK_MODEL=
SAFEDBA_LLM_FALLBACK_BASE_URL=
SAFEDBA_LLM_FALLBACK_API_KEY=
SAFEDBA_LLM_FALLBACK_REASONING_ENABLED=false

# The circuit counts final transient failures after client retries are
# exhausted. Authentication, permission, request, and model errors do not
# trigger failover or open the circuit.
SAFEDBA_LLM_CIRCUIT_FAILURE_THRESHOLD=3
SAFEDBA_LLM_CIRCUIT_COOLDOWN_SECONDS=30


# ------------------------------------------------------------
# Agent runtime budgets
# ------------------------------------------------------------

SAFEDBA_AGENT_MAX_TOTAL_TOOL_CALLS=16
SAFEDBA_AGENT_MAX_TOOL_CALLS_PER_TURN=6
SAFEDBA_AGENT_MAX_TOOL_OUTPUT_CHARS=60000
SAFEDBA_AGENT_DEADLINE_SECONDS=240
SAFEDBA_AGENT_RUNTIME_EVIDENCE_TTL_SECONDS=15

# Optional scoped Agent memory. Memory is used only when a session ID is
# supplied (the interactive CLI creates one automatically).
SAFEDBA_AGENT_STATE_DB_PATH=logs/agent_state.sqlite3
SAFEDBA_AGENT_MEMORY_ENABLED=true
SAFEDBA_AGENT_MEMORY_MAX_SESSION_TURNS=12
SAFEDBA_AGENT_MEMORY_MAX_RELEVANT_EPISODES=4
SAFEDBA_AGENT_MEMORY_TTL_SECONDS=2592000

# Sanitized experience capture supports explicit feedback, immutable dataset
# export, and offline promotion gates. It never trains or deploys by itself.
SAFEDBA_EXPERIENCE_DB_PATH=logs/experience.sqlite3
SAFEDBA_EXPERIENCE_CAPTURE_ENABLED=true


# ------------------------------------------------------------
# SafeDBA policy
# ------------------------------------------------------------

SAFEDBA_MIN_IMPROVEMENT_PCT=10
SAFEDBA_MAX_CARDINALITY_ERROR_RATIO=2

SAFEDBA_HEALTH_LONG_QUERY_SECONDS=30
SAFEDBA_HEALTH_LONG_TRANSACTION_SECONDS=60


# ------------------------------------------------------------
# Durable IncidentWorkflow
# ------------------------------------------------------------

SAFEDBA_INCIDENT_STATE_DB_PATH=logs/incidents.sqlite3
SAFEDBA_INCIDENT_APPROVAL_TTL_SECONDS=120
SAFEDBA_INCIDENT_MAX_ACTIONS=10
SAFEDBA_INCIDENT_LEASE_SECONDS=60
SAFEDBA_INCIDENT_DEADLINE_SECONDS=300


# ------------------------------------------------------------
# Audit
# ------------------------------------------------------------

SAFEDBA_AUDIT_LOG_PATH=logs/audit.jsonl
SAFEDBA_AUDIT_INCLUDE_QUERY_TEXT=false


# ------------------------------------------------------------
# Optional OpenTelemetry tracing (OTLP/HTTP)
# ------------------------------------------------------------

# Disabled by default. No prompt, SQL, tool payload, credential, or session
# identifier is exported as a span attribute.
SAFEDBA_OTEL_ENABLED=false
SAFEDBA_OTEL_SERVICE_NAME=safedba
SAFEDBA_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
SAFEDBA_OTEL_EXPORT_TIMEOUT_SECONDS=5

# Environment policy (development | staging | production | benchmark).
# Production prohibits runtime EXPLAIN, comparisons, benchmarks, and the
# experimental index/statistics/rewrite workflows, regardless of allow flags.
SAFEDBA_ENV=development

# Defaults below depend on SAFEDBA_ENV. Keep these commented unless choosing
# an explicit startup privilege ceiling. Live controls cannot raise it.
# SAFEDBA_ENABLE_AGENT=true
# SAFEDBA_ENABLE_MUTATIONS=false
# SAFEDBA_ALLOW_RUNTIME_ANALYSIS=false
# SAFEDBA_ALLOW_BENCHMARK=false
# SAFEDBA_ENABLE_CREATE_INDEX=false
# SAFEDBA_ENABLE_ANALYZE_TABLE=false
# SAFEDBA_ENABLE_TERMINATE_BACKEND=false
# SAFEDBA_ENABLE_REWRITE_QUERY=false

# For deliberate, approved production lock remediation, BOTH mutation and
# termination flags must be true. Human approval and identity checks remain.
# Protect this path from the Agent/LLM and untrusted users. Relative paths are
# resolved against the project root. Use a required file in deployments so
# deleting it cannot silently restore the startup privilege ceiling.
SAFEDBA_RUNTIME_CONTROLS_PATH=logs/runtime_controls.json
SAFEDBA_RUNTIME_CONTROLS_REQUIRED=false
